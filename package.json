{
  "name": "food-delivery",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "dist": "node scripts/dist.mjs",
    "build:cloud": "cross-env PRISMA_PROVIDER=mysql prisma generate --schema=prisma/schema.mysql.prisma && cross-env PRISMA_PROVIDER=mysql next build",
    "build:vercel": "cross-env PRISMA_PROVIDER=postgresql prisma generate --schema=prisma/schema.postgresql.prisma && cross-env PRISMA_PROVIDER=postgresql next build",
    "db:vercel:push": "cross-env PRISMA_PROVIDER=postgresql prisma db push --schema=prisma/schema.postgresql.prisma",
    "db:vercel:seed": "cross-env PRISMA_PROVIDER=postgresql npx tsx prisma/seed.ts",
    "db:sql": "npx tsx scripts/generate-timeweb-sql.ts",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "prepare:standalone": "powershell -ExecutionPolicy Bypass -File scripts/prepare-standalone.ps1",
    "postinstall": "node scripts/postinstall.mjs",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "reset-admin": "npx tsx scripts/reset-admin.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.4.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@tanstack/react-query": "^5.90.21",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.34.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.564.0",
    "mariadb": "^3.5.2",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "prisma": "^7.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.1",
    "typescript": "^5"
  }
}
